{
  "name": "ifarm-security-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @ifarm-security/web dev",
    "dev:api": "pnpm --filter @ifarm-security/api dev",
    "security:check": "node scripts/security-check.mjs",
    "migrations:check": "node scripts/migration-check.mjs",
    "rbac:check": "node scripts/rbac-check.mjs",
    "privileges:check": "node scripts/privilege-hardening-check.mjs",
    "invitations:check": "node scripts/access-invitation-check.mjs",
    "memberships:check": "node scripts/membership-lifecycle-check.mjs",
    "http-security:check": "node scripts/http-security-check.mjs",
    "auth:check": "node scripts/auth-readiness-check.mjs",
    "deploy:check": "node scripts/deploy-readiness-check.mjs",
    "stage:smoke": "node scripts/stage-smoke.mjs",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": { "node": ">=24" }
}
